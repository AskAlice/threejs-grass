{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "paths": {
      "threejs-heightfield": [
        "./packages/heightfield/src/index.ts"
      ],
      "threejs-grass": [
        "./packages/grass/src/index.ts"
      ],
      "threejs-grass/react": [
        "./packages/grass/src/react.tsx"
      ]
    }
  },
  "include": [
    "packages/*/src",
    "example"
  ],
  "exclude": [
    "example/vite.config.ts"
  ]
}
